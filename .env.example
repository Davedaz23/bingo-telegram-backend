# Server
NODE_ENV=development
PORT=6000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bingo_telegram

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/webhook/telegram

# Mini App URL (for bot menu button + inline buttons)
MINI_APP_URL=https://bingo-telegram-frontend.vercel.app

# Admin Telegram User IDs (comma-separated)
ADMIN_TELEGRAM_IDS=123456789

# Payment Gateway
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_BASE_URL=https://api.chapa.co/v1

# Deposit Account Numbers
CBE_ACCOUNT=1000123456789
CBE_BIRR_ACCOUNT=1000123456789
ABYSSINIA_ACCOUNT=1000123456789
TELEBIRR_ACCOUNT=1000123456789
DEPOSIT_ACCOUNT_NAME=Your Account Name

# Game Config
MIN_PLAYERS=2
MAX_PLAYERS=400
CARD_PRICE=10
PLATFORM_FEE_PERCENT=20
REFUND_TIMEOUT_MINUTES=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Encryption
ENCRYPTION_KEY=your_32_char_encryption_key_here
